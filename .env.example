# =====================================================================
# AI Skill Verification Platform (Phase 1) - Environment Configuration
# =====================================================================
# Copy this file to ".env" in the project root:
# Copy-Item .env.example .env

# Flask Session & Application Security
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum

# ---------------------------------------------------------------------
# Database Configuration: MySQL through XAMPP (Primary Database)
# ---------------------------------------------------------------------
# Option A: Full Connection URI
# Standard XAMPP default (root user with empty password):
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/skillverify?charset=utf8mb4

# If your MySQL instance uses a password:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/skillverify?charset=utf8mb4

# Option B: Individual Connection Variables
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=skillverify

# ---------------------------------------------------------------------
# Google Gemini AI Integration (Optional)
# ---------------------------------------------------------------------
# Obtain a free key from: https://aistudio.google.com/
# If left empty, the platform automatically uses a transparent, explainable
# local rule-based NLP taxonomy engine.
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# Certificate & Upload Limits
# ---------------------------------------------------------------------
# Score percentage threshold required to earn a verified certificate (Default: 60.0%)
CERTIFICATE_THRESHOLD=60.0

# Maximum file upload size in bytes (16MB default)
MAX_CONTENT_LENGTH=16777216
